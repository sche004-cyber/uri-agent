# Generated Python bytecode
__pycache__/
*.pyc

# Sensitive credentials - must never enter version history
credentials.json
token.json
token.pickle
.env
.env.*

# Test/diagnostic session residue (regenerated by running the test suite)
uri_workspace/sessions/

# Large institutional data directories, excluded by explicit decision
# (uri_workspace/linked_documents/ contains real student PDF/xlsx records
# with roll numbers; institutional_library/ and knowledge/ are large
# reference corpora). ~863MB combined - kept on disk, not tracked.
uri_workspace/linked_documents/
institutional_library/
knowledge/

# Generated/temporary working directories
cache/
temp_evidence/

# Claude Code harness runtime state (not a URI project file)
.claude/
