# Generated Python bytecode
__pycache__/
*.pyc

# Sensitive credentials - must never enter version history
credentials.json
token.json
token.pickle
.env
.env.*
# M15 Part 1: a template, never a real secret - safe to track.
!.env.example

# Test/diagnostic session residue (regenerated by running the test suite)
uri_workspace/sessions/

# Personal/runtime state - specific to one user's install or one
# device, never shared codebase content. See
# uri_core/core/identity.py for the user_id/device_id distinction.
uri_workspace/portable_identity.json
uri_workspace/device_identity.json
uri_workspace/user_profile.json
uri_workspace/user_memory.json
uri_workspace/growth_ledger.json
uri_workspace/approvals.json
uri_workspace/users/
uri_workspace/user_accounts.json
# M14 Part 1: this PC's persistent-server log output, not source.
uri_workspace/logs/
uri_workspace/skill_memory.json
uri_workspace/uri_memory.json
uri_workspace/friction_log.json
uri_workspace/experience.json

# Large institutional data directories, excluded by explicit decision
# (uri_workspace/linked_documents/ contains real student PDF/xlsx records
# with roll numbers; institutional_library/ and knowledge/ are large
# reference corpora). ~863MB combined - kept on disk, not tracked.
uri_workspace/linked_documents/
institutional_library/
knowledge/

# Generated/temporary working directories
cache/
temp_evidence/

# Claude Code harness runtime state (not a URI project file)
.claude/
